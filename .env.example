# Static bearer token Pebble must send as `Authorization: Bearer <token>`.
# Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=generate-a-random-token-here

# UUID of your TRMNL private plugin (Webhook strategy). Found on the
# plugin's edit page after creating it.
TRMNL_PLUGIN_UUID=

# maia (default, human-like play via lc0) or stockfish
ENGINE_KIND=maia

# Starting difficulty. Maia: 1100-1900 in steps of 100. Stockfish: 0-20.
ENGINE_LEVEL=1500

# Only used when ENGINE_KIND=maia -- set by the Dockerfile, override only
# for local runs outside the container.
LC0_PATH=/usr/local/bin/lc0
MAIA_WEIGHTS_DIR=/app/maia_weights

# Only used when ENGINE_KIND=stockfish.
STOCKFISH_PATH=/opt/homebrew/bin/stockfish

# Where game.json lives. Point this at a mounted volume in production so
# state survives redeploys.
STATE_FILE=game.json
